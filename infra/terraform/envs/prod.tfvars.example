# Production single-node environment. Copy to envs/prod.tfvars.
environment = "prod"
region      = "us-east-1"

admin_cidr   = "203.0.113.10/32"   # replace with the office/VPN CIDR
ssh_key_name = "files-admin"        # replace with an existing key pair

instance_type       = "t3.medium"
root_volume_size_gb = 100
enable_termination_protection = true
delete_root_volume_on_termination = false

bucket_versioning     = false
backup_retention_days = 35
