# Copy to terraform.tfvars and edit. Never commit real secrets (this stack has none).
region      = "us-east-1"
environment = "prod"

# REQUIRED: your public IP/CIDR for SSH, e.g. "203.0.113.10/32".
admin_cidr = "203.0.113.10/32"

# Existing EC2 key pair. Leave empty to use console access only.
ssh_key_name = "files-admin"

instance_type         = "t3.medium"
root_volume_size_gb   = 100
enable_termination_protection = true
delete_root_volume_on_termination = false

# DNS is managed outside Terraform: create an A record for files.example.com -> public_ip.
# Caddy obtains the certificate automatically once 80/443 reach the instance.

bucket_versioning     = false
backup_retention_days = 35
