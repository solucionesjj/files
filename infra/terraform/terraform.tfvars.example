# Copy this file to terraform.tfvars, or use one of the envs/*.tfvars files.
# Never commit real secrets. Supply the RDS password out of band:
#
#   export TF_VAR_db_password='replace-with-a-16+-character-password'
#
# Do not put db_password in this file.

region      = "us-east-1"
environment = "dev"

# Networking
vpc_cidr          = "10.20.0.0/16"
nat_gateway_count = 1
portal_origin     = "http://localhost:4200"

# Public edge
# Dev intentionally uses an HTTP listener. Set an ACM certificate ARN for HTTPS.
certificate_arn = ""

# Storage and database
bucket_versioning   = false
multi_az            = false
deletion_protection = false
db_engine_version   = "18.6"
db_instance_class   = "db.t4g.medium"

# Application configuration (non-secret). Replace with real Entra IDs/origins.
# app_environment = {
#   Entra__TenantId          = "00000000-0000-0000-0000-000000000000"
#   Entra__ApiClientId       = "00000000-0000-0000-0000-000000000000"
#   Entra__ApiAudience       = "api://00000000-0000-0000-0000-000000000000"
#   Entra__PortalClientId    = "00000000-0000-0000-0000-000000000000"
#   Cors__AllowedOrigins__0  = "http://localhost:4200"
#   Portal__BaseUrl          = "http://localhost:4200"
#   Notifications__FromAddress = "files-noreply@example.com"
# }
# Additional secrets: map of config key to Secrets Manager ARN.
# app_secrets = {
#   Entra__ClientSecret = "arn:aws:secretsmanager:us-east-1:000000000000:secret:files/entra-xxxxx"
# }
# otel_endpoint = "http://otel-collector:4317"

# Notifications
# alarm_email = "oncall@example.com"
# alarm_topic_arn = ""

# Optional image overrides. Empty uses <ecr-repository>:bootstrap.
# api_image    = ""
# worker_image = ""
