# /etc/cron.d/files-backup — nightly PostgreSQL dump to S3 (35-day lifecycle).
# Runs as the deploy user; authenticates with the static keys from /opt/files/.env.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 2 * * * ubuntu /opt/files/app/deploy/backup.sh >> /var/log/files-backup.log 2>&1
