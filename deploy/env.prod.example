# /opt/files/.env — copy and fill. chmod 600, owner deploy user. NEVER commit.
# Compose reads this file via --env-file. Connection strings contain semicolons;
# do not source this file from a shell.

FILES_DOMAIN=files.example.com
FILES_VERSION=dev
POSTGRES_DB=files
POSTGRES_USER=files
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
ConnectionStrings__FilesDb=Host=postgres;Port=5432;Database=files;Username=files;Password=CHANGE_ME_LONG_RANDOM;SSL Mode=Disable

ASPNETCORE_ENVIRONMENT=Production
S3__Region=us-east-1
S3__Bucket=files-prod-<account>-<region>-<suffix>
# No S3 access keys in production: the EC2 instance role is used.
S3__ForcePathStyle=false
S3__UseSsl=true

Entra__Instance=https://login.microsoftonline.com/
Entra__TenantId=00000000-0000-0000-0000-000000000000
Entra__ApiClientId=11111111-1111-1111-1111-111111111111
Entra__ApiAudience=api://11111111-1111-1111-1111-111111111111
Entra__PortalClientId=22222222-2222-2222-2222-222222222222
Entra__RequiredScope=Files.Access
Entra__RequireTenantMatch=true

Auth__ApiKeyPepper=CHANGE_ME_32_BYTES_BASE64
Auth__ApiKeyPepperVersion=1
Auth__LinkKeyPepper=CHANGE_ME_32_BYTES_BASE64
Auth__LinkKeyPepperVersion=1

Storage__MaxFileSizeBytes=5368709120
Storage__ChunkSizeBytes=16777216
Storage__S3PartSizeBytes=67108864
Storage__S3SinglePutThresholdBytes=67108864
Storage__StagingPath=/var/lib/files/staging
Storage__StagingReserveBytes=10737418240
Storage__MaxConcurrentSessions=3
Storage__MaxChunkCount=10000
Storage__UploadSessionTtlMinutes=60
Storage__AbortIncompleteAfterHours=24
Storage__GrantTtlSeconds=120

Notifications__Provider=Graph
Notifications__FromAddress=files-noreply@example.com
Notifications__FromDisplayName=Files
Notifications__GraphTenantId=00000000-0000-0000-0000-000000000000
Notifications__GraphClientId=33333333-3333-3333-3333-333333333333
Notifications__GraphClientSecret=CHANGE_ME

Cors__AllowedOrigins__0=https://files.example.com
Portal__BaseUrl=https://files.example.com
Features__PublicLinks=true
# Enable only after a scanner (ClamAV) is deployed; otherwise files would stay processing.
Features__MalwareScanning=false

# Leave empty unless the optional otel-collector profile is running (then use http://otel-collector:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=files-api
SIGNOZ_OTLP_ENDPOINT=
