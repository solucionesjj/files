# /opt/files/.env — copy and fill. chmod 600, owner deploy user. NEVER commit.
# Compose reads this file via --env-file. Connection strings contain semicolons;
# do not source this file from a shell.

FILES_DOMAIN=files.sacservices.cloud
FILES_VERSION=dev
POSTGRES_DB=files
POSTGRES_USER=files
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
ConnectionStrings__FilesDb=Host=postgres;Port=5432;Database=files;Username=files;Password=CHANGE_ME_LONG_RANDOM;SSL Mode=Disable

ASPNETCORE_ENVIRONMENT=Production
S3__Region=us-east-2
S3__Bucket=ecs-files-production
# The bucket already exists and its policy restricts access to this host.
# Authenticate with a static access key (there is no EC2 instance role).
S3__AccessKeyId=CHANGE_ME
S3__SecretAccessKey=CHANGE_ME
S3__ForcePathStyle=false
S3__UseSsl=true

Entra__Instance=https://login.microsoftonline.com/
Entra__TenantId=00000000-0000-0000-0000-000000000000
Entra__ApiClientId=11111111-1111-1111-1111-111111111111
Entra__ApiAudience=api://11111111-1111-1111-1111-111111111111
Entra__RequiredScope=Files.Access
Entra__RequireTenantMatch=true
Entra__ClockSkewSeconds=120

Auth__LinkKeyPepper=CHANGE_ME_32_BYTES_BASE64
Auth__LinkKeyPepperVersion=1
# Promote the first administrator on their first sign-in (ADR-0014).
Auth__BootstrapAdminEmail=jmartinez@ecs-la.com

Storage__MaxFileSizeBytes=5368709120
Storage__ChunkSizeBytes=16777216
Storage__S3PartSizeBytes=67108864
Storage__S3SinglePutThresholdBytes=67108864
Storage__StagingPath=/var/lib/files/staging
Storage__StagingReserveBytes=10737418240
Storage__MaxConcurrentSessions=3
Storage__MaxChunkCount=10000
Storage__UploadSessionTtlMinutes=60
Storage__AbortIncompleteAfterHours=24
Storage__GrantTtlSeconds=120

Notifications__FromAddress=notificationsagent@ecs-la.com
Notifications__FromDisplayName=Files
Notifications__DefaultLocale=es-CO
Smtp__Host=smtp.office365.com
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__Username=notificationsagent@ecs-la.com
# The only SMTP secret; read from env, never logged. (Smtp__Password is a legacy alias.)
Smtp__AppPassword=CHANGE_ME_APP_PASSWORD

Cors__AllowedOrigins__0=https://files.sacservices.cloud
Portal__BaseUrl=https://files.sacservices.cloud
Portal__SupportEmail=files-support@example.com
# Features__PublicLinks is only reported in /v1/config; link creation is governed by
# platform_settings.public_links_enabled (admin). Features__MalwareScanning is enforced.
Features__PublicLinks=true
Features__MalwareScanning=true
ClamAV__Host=clamav
ClamAV__Port=3310
ClamAV__ScanTimeoutSeconds=900

# Worker job cadence + notification retry limits (seconds).
Scheduler__NotificationScheduleSeconds=3600
Scheduler__NotificationSendSeconds=60
Scheduler__ExpirationSeconds=900
Scheduler__NotificationMaxAttempts=5
Scheduler__SenderReclaimSeconds=600
Scheduler__MigrationBatchSize=500
Scheduler__DeletionSeconds=300
Scheduler__ReconcileSeconds=86400
Scheduler__PurgeSeconds=86400
Scheduler__DeletionMaxAttempts=10
Scheduler__DeletionBatchSize=100
Scheduler__ReconcileBatchSize=500

# Leave empty unless the optional otel-collector profile is running (then use http://otel-collector:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=files-api
SIGNOZ_OTLP_ENDPOINT=
