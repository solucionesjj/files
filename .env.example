# Files — development environment template
# Copy to .env (gitignored). The values below are DEV-ONLY and must never be used in a shared
# environment. Generate real peppers with: openssl rand -base64 32

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
DOTNET_ENVIRONMENT=Development

# --- Database -----------------------------------------------------------------
ConnectionStrings__FilesDb=Host=localhost;Port=5432;Database=files;Username=files;Password=files

# --- Microsoft Entra ID -------------------------------------------------------
# Replace with the real tenant/app registrations before testing sign-in.
Entra__Instance=https://login.microsoftonline.com/
Entra__TenantId=00000000-0000-0000-0000-000000000000
Entra__ApiClientId=11111111-1111-1111-1111-111111111111
Entra__ApiAudience=api://11111111-1111-1111-1111-111111111111
Entra__PortalClientId=22222222-2222-2222-2222-222222222222
Entra__RequiredScope=Files.Access
Entra__RequireTenantMatch=true
Entra__ClockSkewSeconds=120

# --- Credential peppers (version 1) ------------------------------------------
Auth__ApiKeyPepper=JXEcWHQjs/PgK3QjcJKor/7oz0Oo7E169UA+enfE3IU=
Auth__ApiKeyPepperVersion=1
Auth__LinkKeyPepper=NxXCKCrYEc67p3o6zMX8DYS2BSafWbNJ6Prpg8tm9XM=
Auth__LinkKeyPepperVersion=1

# --- Object storage (local LocalStack S3) -------------------------------------------
S3__Region=us-east-1
S3__Bucket=files-local
S3__ServiceUrl=http://localhost:4566
S3__ForcePathStyle=true
S3__UseSsl=false
S3__AccessKeyId=test
S3__SecretAccessKey=test

# --- Storage limits ----------------------------------------------------------
Storage__MaxFileSizeBytes=5368709120
Storage__ChunkSizeBytes=16777216
Storage__MaxChunkCount=10000
Storage__S3PartSizeBytes=67108864
Storage__S3SinglePutThresholdBytes=67108864
Storage__StagingPath=/var/tmp/files-staging
Storage__StagingReserveBytes=1073741824
Storage__MaxConcurrentSessions=3
Storage__UploadSessionTtlMinutes=60
Storage__GrantTtlSeconds=120
Storage__AbortIncompleteAfterHours=24

# --- Abuse / rate limits -----------------------------------------------------
Abuse__MaxKeyAttemptsPerWindow=5
Abuse__KeyAttemptWindowMinutes=15
Abuse__KeyLockoutMinutes=15
Abuse__MaxFailuresPerLinkPerHour=100

# --- Email (local Mailpit; production M365 SMTP AUTH 587) --------------------
Notifications__Provider=Smtp
Notifications__FromAddress=files@example.com
Notifications__FromDisplayName=Files
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseStartTls=false
Smtp__Username=
Smtp__Password=
# Production: smtp.office365.com:587, STARTTLS, full mailbox address + app password.
# Optional Graph fallback: Notifications__Provider=Graph + Graph client/tenant/secret.

# --- Portal / CORS -----------------------------------------------------------
Cors__AllowedOrigins__0=http://localhost:4200
Portal__BaseUrl=http://localhost:4200
Portal__SupportEmail=files-support@example.com

# --- Features ----------------------------------------------------------------
Features__PublicLinks=true
Features__MalwareScanning=false
Features__Notifications=true

# --- Telemetry ---------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=files-api
OTEL_TRACES_SAMPLER=parentbased_always_on

# --- Workers / jobs ----------------------------------------------------------
Jobs__Enabled=true
Jobs__EnvironmentConcurrency=1
